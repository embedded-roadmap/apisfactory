{
  "name": "apisfactory",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev:api": "pnpm --filter @apisfactory/api dev",
    "dev:web": "pnpm --filter @apisfactory/web dev",
    "dev:mobile": "pnpm --filter @apisfactory/mobile start",
    "db:migrate": "pnpm --filter @apisfactory/api migrate",
    "db:seed": "pnpm --filter @apisfactory/api seed",
    "db:seed-scenario": "pnpm --filter @apisfactory/api seed:scenario",
    "test": "pnpm --filter @apisfactory/api test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.71.0"
  }
}
