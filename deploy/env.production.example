# Üretim ortam değişkenleri — sunucuda bu dosyayı deploy/.env olarak kopyalayıp doldurun. .env git'e EKLENMEZ.
# Rastgele değer üretmek için:  openssl rand -hex 32

# --- Alan adları ---
# API'nin yayınlanacağı alan adı (DNS A kaydı bu sunucunun IP'sine yönlenmeli), ör. api.embeddedroad.com
API_DOMAIN=
# Let's Encrypt bildirim e-postası
ACME_EMAIL=
# Web arayüzünün (Vercel) tam adresi — CORS yalnız buna izin verir, ör. https://app.embeddedroad.com
CORS_ORIGIN=

# --- Veritabanı parolaları (hepsi farklı, en az 32 karakter) ---
POSTGRES_SUPERUSER_PASSWORD=
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=

# --- Uygulama sırları ---
# Oturum imzası (en az 32 karakter)
JWT_SECRET=
# Bağlayıcı erişim bilgilerini (distribütör, e-fatura, kargo, SMS, SMTP) şifreleyen anahtar. KAYBEDİLİRSE kayıtlı
# erişim bilgileri çözülemez; güvenli bir yerde yedekleyin.
CONNECTOR_SECRET_KEY=
SESSION_HOURS=12
# Yedekleri şifreleyen anahtar (yedek servisi için zorunlu). Kaybedilirse yedekler açılamaz; CONNECTOR_SECRET_KEY ile
# birlikte sunucu DIŞINDA güvenli bir yerde saklayın.
BACKUP_ENCRYPTION_KEY=

# --- Nesne depolama (varsayılan: sunucu diski, "objects" birimi) ---
STORAGE_BACKEND=local
# Yurt içi S3 uyumlu servise geçerken: STORAGE_BACKEND=s3 ve S3_ENDPOINT, S3_BUCKET, S3_REGION,
# S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, S3_FORCE_PATH_STYLE (bkz. docs/devam-notu.md "yurt içi S3").

# --- İsteğe bağlı platform entegrasyonları (boş bırakılırsa kapalıdır) ---
# ANTHROPIC_API_KEY, GOOGLE_OAUTH_CLIENT_ID/SECRET, MS_OAUTH_CLIENT_ID/SECRET, OAUTH_REDIRECT_BASE,
# IYZICO_API_KEY, IYZICO_SECRET_KEY, IYZICO_BASE_URL, PUBLIC_API_BASE
