# API alan adı için otomatik Let's Encrypt sertifikası ve ters vekil.
# E-posta gerekmez (Let's Encrypt 2025'te süre bitimi e-postalarını kaldırdı); Caddy sertifikayı kendisi yeniler.

{$API_DOMAIN} {
	encode gzip
	# Büyük video/dosya yüklemeleri (uygulama sınırı 200 MB) için gövde sınırı.
	request_body {
		max_size 250MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		-Server
	}
	reverse_proxy api:4000
}
