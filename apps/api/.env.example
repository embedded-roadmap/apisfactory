# Sır içermeyen şablon. Kopyalayıp .env olarak düzenleyin.
DATABASE_URL=postgres://apis_app:app_dev_pw@localhost:5432/apisfactory
MIGRATION_DATABASE_URL=postgres://apis_owner:owner_dev_pw@localhost:5432/apisfactory
JWT_SECRET=degistirin-en-az-32-karakter-rastgele-bir-deger
PORT=4000
CORS_ORIGIN=http://localhost:5173
# Bağlayıcı (e-fatura entegratörü vb.) erişim bilgilerini şifreleyen anahtar: 32 bayt, base64 veya 64 hane hex.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Kaybedilirse kayıtlı erişim bilgileri çözülemez — yeniden girilmeleri gerekir.
CONNECTOR_SECRET_KEY=
