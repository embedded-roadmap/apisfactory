# Sır içermeyen şablon. Kopyalayıp apps/api/.env olarak düzenleyin — sunucu açılışta bu dosyayı okur
# (src/config.ts). Ortamda zaten tanımlı değişkenler (hosting secret store) dosyadaki değerden önceliklidir.
DATABASE_URL=postgres://apis_app:app_dev_pw@localhost:5432/apisfactory
MIGRATION_DATABASE_URL=postgres://apis_owner:owner_dev_pw@localhost:5432/apisfactory
JWT_SECRET=degistirin-en-az-32-karakter-rastgele-bir-deger
PORT=4000
CORS_ORIGIN=http://localhost:5173
# Bağlayıcı (e-fatura entegratörü vb.) erişim bilgilerini şifreleyen anahtar: 32 bayt, base64 veya 64 hane hex.
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Kaybedilirse kayıtlı erişim bilgileri çözülemez — yeniden girilmeleri gerekir.
CONNECTOR_SECRET_KEY=
# Yönetici raporu AI yorum katmanı (Anthropic Claude) — console.anthropic.com → API Keys. Boşsa AI yorumu kapalıdır.
ANTHROPIC_API_KEY=
# İsteğe bağlı model seçimi (varsayılan: claude-opus-5).
AI_MODEL=
# Takvim senkronu (platform OAuth uygulaması — kullanıcılar kendi hesaplarını ekrandan bağlar).
# Yönlendirme adresi sağlayıcıya şu şekilde kaydedilmeli: {OAUTH_REDIRECT_BASE}/api/calendar/oauth/callback/google (veya /microsoft)
OAUTH_REDIRECT_BASE=http://localhost:4000
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application); Google Calendar API etkin.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Azure portal → Microsoft Entra ID → App registrations; izinler: Calendars.ReadWrite, User.Read, offline_access.
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
# Tek kiracı için dizin kimliği; boşsa "common" (iş ve kişisel hesaplar).
MS_OAUTH_TENANT=
# Abonelik ücreti tahsilatı (iyzico Abonelik) — platform işletmecisinin iyzico hesabı.
# Sandbox: https://sandbox-api.iyzipay.com  ·  Canlı: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# iyzico'nun ödeme dönüşünü ve bildirimini gönderdiği API adresi (dışarıdan erişilebilir olmalı).
# Bildirim adresi iyzico panelinde: {PUBLIC_API_BASE}/api/subscription/iyzico/webhook
PUBLIC_API_BASE=http://localhost:4000
# Ödeme alınamazsa kısıtlamaya kadar ek süre (gün).
SUBSCRIPTION_GRACE_DAYS=14
