{
  "name": "@apisfactory/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "seed:scenario": "tsx src/db/seed-scenario.ts",
    "outbox": "tsx src/worker/outbox.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "loadtest": "node scripts/loadtest.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@apisfactory/shared": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "archiver": "^8.0.0",
    "fastify": "^5.1.0",
    "jose": "^5.9.6",
    "papaparse": "^5.4.1",
    "pg": "^8.13.1",
    "pg-copy-streams": "^7.0.0",
    "tar": "^7.5.22",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.10.0",
    "@types/papaparse": "^5.3.15",
    "@types/pg": "^8.11.10",
    "@types/pg-copy-streams": "^1.2.5",
    "autocannon": "^8.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.8"
  }
}
